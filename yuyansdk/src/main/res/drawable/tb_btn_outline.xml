<?xml version="1.0" encoding="utf-8"?>
<!-- 描边按钮：卡片底加粗描边，圆角 6，普通动作都用它 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="@color/tb_bg" />
                    <stroke android:width="1dp" android:color="@color/tb_border" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="@color/tb_card" />
                    <stroke android:width="1dp" android:color="@color/tb_border_strong" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
