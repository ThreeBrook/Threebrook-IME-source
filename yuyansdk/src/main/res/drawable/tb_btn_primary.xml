<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮：溪青实心，圆角 10（三溪外观规范第 5 节），只给页面上最主要的动作 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="@color/tb_track" />
                    <stroke android:width="1dp" android:color="@color/tb_border" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="@color/tb_accent" />
                    <stroke android:width="1dp" android:color="@color/tb_accent" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
