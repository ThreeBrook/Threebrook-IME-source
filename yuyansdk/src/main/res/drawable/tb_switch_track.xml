<?xml version="1.0" encoding="utf-8"?>
<!-- 开关轨道：打开 accent；关闭 track 底加 borderStrong 细描边（三溪外观规范第 5 节） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <size android:width="52dp" android:height="26dp" />
            <solid android:color="@color/tb_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <size android:width="52dp" android:height="26dp" />
            <solid android:color="@color/tb_track" />
            <stroke android:width="1dp" android:color="@color/tb_border_strong" />
        </shape>
    </item>
</selector>
