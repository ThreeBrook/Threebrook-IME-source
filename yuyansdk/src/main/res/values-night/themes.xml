<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Theme.AppTheme 只在 values/themes.xml 定义一次，深色的差别都在 values-night/colors.xml 和 bools.xml -->
    <style name="Theme.CropActivityTheme" parent="Theme.AppCompat.DayNight">
        <item name="android:statusBarColor">?android:attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
